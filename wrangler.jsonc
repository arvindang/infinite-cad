{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-cad",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": { "command": "npm run build:web", "watch_dir": ["src", "web"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/m/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MODELS", "class_name": "CadModel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CadModel"] }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "infinite_cad_events" }],
  "observability": { "enabled": true }
}
